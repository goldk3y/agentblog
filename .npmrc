# pnpm's default isolated node_modules layout.
#
# We deliberately do NOT hoist. `packages/eslint-config` pins its own
# `typescript@6` because typescript-eslint refuses to load against TypeScript 7,
# while every package type checks with `tsc` 7. Those two versions can only
# coexist in an isolated layout.
strict-peer-dependencies=false
auto-install-peers=true

# Native binaries that must run their postinstall to produce a working install.
only-built-dependencies[]=esbuild
only-built-dependencies[]=sharp
only-built-dependencies[]=@tailwindcss/oxide
only-built-dependencies[]=unrs-resolver
