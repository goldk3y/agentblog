# Matches .prettierrc.json. Kept in sync by hand, which is fine because both
# files change roughly never.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
