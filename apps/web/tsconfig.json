{
  "extends": "@agentblog/typescript-config/nextjs.json",
  "compilerOptions": {
    // `@/agentblog.config` is listed first and as an exact match, because exact
    // path mappings win over wildcard ones. Without it, `./registry/blog/*`
    // resolves the entry to the registry's *template* config (placeholder brand,
    // `https://yourdomain.com`) instead of this app's real one, and the dogfood
    // site renders someone else's example values. Everything else is meant to
    // resolve registry-first: that is what makes the demo blog the same modules
    // the registry ships. See https://agentblog.dev/docs/cli-reference
    "paths": {
      "@/agentblog.config": ["./agentblog.config.ts"],
      "@/*": ["./registry/blog/*", "./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "public/r"]
}
