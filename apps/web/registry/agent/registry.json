{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "agentblog-agent",
  "homepage": "https://agentblog.dev",
  "items": [
    {
      "name": "agent-kit",
      "type": "registry:block",
      "title": "AgentBlog agent kit",
      "description": "Six skills that take a blog from install to published: finish the setup for your site, plan the topic clusters, write posts to the GEO playbook, refresh them without falsifying dateModified, audit before publish, and publish with the IndexNow response code actually read. Installs into your project's .claude/skills directory, so any agent working in this repository picks them up. Also available as a Claude Code plugin and through npx skills add.",
      "categories": ["blog", "agents", "claude-code"],
      "files": [
        {
          "path": "skills/agentblog-setup/SKILL.md",
          "type": "registry:file",
          "target": "~/.claude/skills/agentblog-setup/SKILL.md"
        },
        {
          "path": "skills/plan-blog-content/SKILL.md",
          "type": "registry:file",
          "target": "~/.claude/skills/plan-blog-content/SKILL.md"
        },
        {
          "path": "skills/write-blog-post/SKILL.md",
          "type": "registry:file",
          "target": "~/.claude/skills/write-blog-post/SKILL.md"
        },
        {
          "path": "skills/write-blog-post/references/geo-playbook.md",
          "type": "registry:file",
          "target": "~/.claude/skills/write-blog-post/references/geo-playbook.md"
        },
        {
          "path": "skills/write-blog-post/references/schema-reference.md",
          "type": "registry:file",
          "target": "~/.claude/skills/write-blog-post/references/schema-reference.md"
        },
        {
          "path": "skills/write-blog-post/references/voice.md",
          "type": "registry:file",
          "target": "~/.claude/skills/write-blog-post/references/voice.md"
        },
        {
          "path": "skills/write-blog-post/references/checklist.md",
          "type": "registry:file",
          "target": "~/.claude/skills/write-blog-post/references/checklist.md"
        },
        {
          "path": "skills/refresh-blog-post/SKILL.md",
          "type": "registry:file",
          "target": "~/.claude/skills/refresh-blog-post/SKILL.md"
        },
        {
          "path": "skills/agentblog-audit/SKILL.md",
          "type": "registry:file",
          "target": "~/.claude/skills/agentblog-audit/SKILL.md"
        },
        {
          "path": "skills/publish-blog-post/SKILL.md",
          "type": "registry:file",
          "target": "~/.claude/skills/publish-blog-post/SKILL.md"
        },
        {
          "path": "AGENTS.agentblog.md",
          "type": "registry:file",
          "target": "~/AGENTS.agentblog.md"
        }
      ],
      "docs": "Skills installed. AGENTS.agentblog.md is a fragment, not a replacement for your AGENTS.md. Run `npx agentblog@latest doctor --fix` to merge it into your real AGENTS.md, outside the block Next.js manages, and to finish wiring next.config.ts. Then ask your agent to finish the setup."
    }
  ]
}
